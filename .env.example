# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# These are read automatically by @softeria/ms-365-mcp-server (the MCP server
# used in .mcp.json / .vscode/mcp.json) from the directory it is started in.
#
# See README.md > "Required credentials" for how to obtain these from an
# Azure AD (Microsoft Entra ID) App Registration.

# Entra ID Tenant/Directory ID. Use "common" (multi-tenant), "consumers"
# (personal Microsoft accounts), "organizations" (any work/school tenant),
# or your specific tenant GUID.
MS365_MCP_TENANT_ID=common

# Application (client) ID of your Azure AD App Registration.
# Required for Teams (org-mode) so a tenant admin can grant consent.
MS365_MCP_CLIENT_ID=

# Client secret for the App Registration (optional — only needed for
# confidential-client flows; device-code/interactive login does not need it).
MS365_MCP_CLIENT_SECRET=

# Microsoft cloud environment: "global" (default) or "china" (21Vianet).
MS365_MCP_CLOUD_TYPE=global
